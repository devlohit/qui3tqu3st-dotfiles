
# ~/.config/hypr/hyprlock.conf

$mocha-base = rgb(1e1e2e)
$mocha-surface0 = rgb(313244)
$mocha-text = rgb(cdd6f4)
$mocha-subtext0 = rgb(a6adc8)
$mocha-mauve = rgb(cba6f7)
$mocha-red = rgb(f38ba8)
$mocha-green = rgb(a6e3a1)

general {
    disable_loading_bar = false
    grace = 2
    hide_cursor = true
    no_fade_in = false
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
    noise = 0.0117
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# Clock
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = $mocha-text
    font_size = 90
    font_family = JetBrainsMono Nerd Font Bold
    position = 0, 300
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%A, %B %d")"
    color = $mocha-subtext0
    font_size = 22
    font_family = JetBrainsMono Nerd Font
    position = 0, 200
    halign = center
    valign = center
}

# Username (static label)
label {
    monitor =
    text = $USER
    color = $mocha-text
    font_size = 17
    font_family = JetBrainsMono Nerd Font Bold
    position = 0, -16
    halign = center
    valign = center
}

# Password input field
input-field {
    monitor =
    size = 300, 55
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    outer_color = $mocha-mauve
    inner_color = $mocha-surface0
    font_color = $mocha-text
    fade_on_empty = false
    placeholder_text = <span foreground="##a6adc8">Password...</span>
    hide_input = false
    check_color = $mocha-green
    fail_color = $mocha-red
    fail_text = <span foreground="##f38ba8">Wrong password</span>
    capslock_color = $mocha-red
    position = 0, -80
    halign = center
    valign = center
}
